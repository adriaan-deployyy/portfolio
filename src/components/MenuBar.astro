---
interface Props {
  appName?: string;
  menus?: string[];
}

const { appName = "Finder", menus = ["File", "Edit", "View", "Item", "Window", "Help"] } = Astro.props;
---

<header class="menubar">
  <div class="menubar__leading">
    <!-- Deployyy mark in the Figma's Apple-logo slot -->
    <a
      class="menubar__item menubar__logo"
      href="https://deployyy.co"
      target="_blank"
      rel="noopener"
      aria-label="Deployyy.co (opens in a new tab)"
    >
      <svg width="22" height="10" viewBox="0 0 22 10" fill="none" aria-hidden="true">
        <path
          d="M9.87461 0.258587V4.96917C9.87461 5.16197 9.69578 5.2952 9.55946 5.43153L5.18243 9.80856C5.01682 9.97417 4.75921 9.84536 4.75921 9.62455V5.24518C4.75921 5.17158 4.70401 5.11638 4.6304 5.11638H0.251034C0.0302258 5.11638 -0.0801785 4.84037 0.0670272 4.69316L4.64881 0.111381C4.72241 0.0377781 4.81441 0.000976562 4.90642 0.000976562H9.617C9.76421 0.000976562 9.87461 0.111381 9.87461 0.258587Z"
          fill="currentColor"></path>
        <path
          d="M12.1074 9.62516V4.91458C12.1074 4.72178 12.2862 4.58854 12.4226 4.45222L16.7996 0.0751858C16.9652 -0.0904207 17.2228 0.0383843 17.2228 0.259193V4.65697C17.2228 4.73057 17.278 4.78577 17.3516 4.78577H21.7494C21.9702 4.78577 22.0806 5.06178 21.9334 5.20899L17.3516 9.79077C17.278 9.86437 17.186 9.90117 17.094 9.90117H12.7449C12.4797 9.90117 12.1074 9.89035 12.1074 9.62516Z"
          fill="currentColor"></path>
      </svg>
    </a>
    <!-- The app name opens that app's window (Finder) -->
    <button class="menubar__item menubar__app" type="button" data-open-window="finder" aria-haspopup="dialog">{appName}</button>
    {
      menus.map((menu) => (
        <button class="menubar__item" type="button">
          {menu}
        </button>
      ))
    }
  </div>

  <div class="menubar__trailing">
    <span class="menubar__status menubar__wifi" aria-label="Wi-Fi" role="img">
      <img src="/figma/light/wifi.svg" alt="" width="34.5" height="20" />
    </span>
    <button
      class="menubar__item menubar__spotlight"
      type="button"
      aria-label="Search the site (Spotlight)"
      aria-haspopup="dialog"
      aria-keyshortcuts="Meta+K Control+K"
      title="Search (⌘K)"
      data-spotlight-open>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="6.75" cy="6.75" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="m10.3 10.3 3.7 3.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    <button class="menubar__status menubar__control-center" type="button" aria-label="Control Center: switch light or dark mode" data-theme-toggle>
      <img src="/figma/light/control-center.svg" alt="" width="31.15" height="21.41" />
    </button>
    <time class="menubar__clock" data-clock>
      <span data-clock-date>Wed Apr 1</span>
      <span data-clock-time>9:41 AM</span>
    </time>
  </div>

  <!-- Phones: an iPhone status bar instead (time on the left, Wi-Fi and battery on the right) -->
  <div class="statusbar">
    <time class="statusbar__time" data-phone-clock>9:41</time>
    <div class="statusbar__icons">
      <svg class="statusbar__wifi" width="17" height="12" viewBox="0 0 17 12" role="img" aria-label="Wi-Fi">
        <path d="M.72 3.72a11 11 0 0 1 15.56 0L14.3 5.7a8.2 8.2 0 0 0-11.6 0Z" />
        <path d="M3.41 6.41a7.2 7.2 0 0 1 10.18 0L11.75 8.25a4.6 4.6 0 0 0-6.5 0Z" />
        <path d="M5.95 8.95a3.6 3.6 0 0 1 5.1 0L8.5 11.5Z" />
      </svg>
      <svg class="statusbar__battery" width="27" height="13" viewBox="0 0 27 13" role="img" aria-label="Battery" data-battery>
        <rect class="statusbar__battery-case" x="0.5" y="0.5" width="23" height="12" rx="3.8" />
        <path class="statusbar__battery-cap" d="M25 4.5v4a2.2 2.2 0 0 0 0-4Z" />
        <rect class="statusbar__battery-level" x="2" y="2" width="20" height="9" rx="2.4" data-battery-level />
      </svg>
    </div>
  </div>
</header>

<style>
  /* Figma: Menu Bar, 34px tall, 10px left / 20px right padding, 5px vertical */
  .menubar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--menubar-height);
    padding: 5px 20px 5px 10px;
    color: var(--menubar-text);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    font-weight: var(--weight-emphasized);
    user-select: none;
  }

  .menubar__leading,
  .menubar__trailing {
    display: flex;
    align-items: center;
  }

  .menubar__item {
    display: flex;
    align-items: center;
    height: 24px;
    padding: 4px 9px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .menubar__item:hover,
  .menubar__status:hover {
    background: var(--menubar-item-hover);
  }

  .menubar__logo {
    justify-content: center;
    width: 33px;
    padding: 0;
    color: inherit;
    text-decoration: none;
  }

  .menubar__logo svg {
    display: block;
  }

  .menubar__app {
    padding: 4px 9px 4px 11px;
    font-weight: var(--weight-heavy);
  }

  .menubar__status {
    display: flex;
    border-radius: 4px;
  }

  .menubar__wifi img {
    display: block;
    width: 34.5px;
    height: 20px;
  }

  .menubar__spotlight {
    justify-content: center;
    width: 34px;
    padding: 0;
  }

  .menubar__control-center img {
    display: block;
    width: 31.15px;
    height: 21.41px;
  }

  /* Figma: Date and Time, 13.1px, 8px between date and time */
  .menubar__clock {
    display: flex;
    gap: 8px;
    padding-left: 9px;
    font-size: 13.1px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /*
   * iPhone status bar: the time centred in the left "ear" beside the notch, Wi-Fi and battery
   * in the right one. Battery shows the real level where the browser shares it (Chrome on
   * Android), otherwise full; low is red and charging is green, as on iOS.
   */
  .statusbar {
    display: none;
  }

  @media (max-width: 640px) {
    .menubar {
      padding: 0;
    }

    .menubar__leading,
    .menubar__trailing {
      display: none;
    }

    .statusbar {
      display: grid;
      grid-template-columns: 1fr 126px 1fr; /* 126px: room for the notch / Dynamic Island */
      align-items: center;
      width: 100%;
      height: 100%;
      padding-top: 2px;
    }

    .statusbar__time {
      justify-self: center;
      font-size: 17px;
      line-height: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }

    .statusbar__icons {
      grid-column: 3;
      justify-self: center;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .statusbar svg {
      display: block;
      fill: currentColor;
    }

    .statusbar__battery-case {
      fill: none;
      stroke: currentColor;
      stroke-opacity: 0.4;
    }

    .statusbar__battery-cap {
      opacity: 0.45;
    }

    .statusbar__battery[data-state="low"] .statusbar__battery-level {
      fill: #ff3b30;
    }

    .statusbar__battery[data-state="charging"] .statusbar__battery-level {
      fill: #34c759;
    }
  }
</style>

<script>
  import { toggleTheme } from "../scripts/theme";

  const date =document.querySelector<HTMLElement>("[data-clock-date]");
  const time = document.querySelector<HTMLElement>("[data-clock-time]");
  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");

  const dateFormat = new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric" });
  const timeFormat = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" });
  const weekdayFormat = new Intl.DateTimeFormat("en-US", { weekday: "short" });

  // The Dock's Calendar icon (light and dark versions) shows the same day as the menu bar
  const calendarWeekdays = document.querySelectorAll<HTMLElement>("[data-cal-weekday]");
  const calendarDates = document.querySelectorAll<HTMLElement>("[data-cal-date]");

  // iPhone status bar: the visitor's own time format, without AM / PM (as iOS shows it)
  const phoneClock = document.querySelector<HTMLTimeElement>("[data-phone-clock]");
  const phoneFormat = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" });
  const phoneTime = (date: Date) =>
    phoneFormat
      .formatToParts(date)
      .filter((part) => part.type !== "dayPeriod")
      .map((part) => part.value)
      .join("")
      .trim();

  const tick = () => {
    const now = new Date();
    if (phoneClock) {
      phoneClock.textContent = phoneTime(now);
      phoneClock.setAttribute("datetime", now.toISOString());
    }
    // "Wed, Apr 1" -> "Wed Apr 1", matching the macOS menu bar
    if (date) date.textContent = dateFormat.format(now).replace(",", "");
    if (time) time.textContent = timeFormat.format(now);
    clock?.setAttribute("datetime", now.toISOString());
    for (const el of calendarWeekdays) el.textContent = weekdayFormat.format(now);
    for (const el of calendarDates) el.textContent = String(now.getDate());
  };

  tick();
  // Re-sync on each minute boundary
  setTimeout(() => {
    tick();
    setInterval(tick, 60_000);
  }, 60_000 - (Date.now() % 60_000));

  /*
   * Battery: the real level where the browser shares it (the Battery Status API, Chrome on
   * Android); Safari and Firefox don't, so the icon stays full there.
   */
  type BatteryManager = EventTarget & { level: number; charging: boolean };
  const battery = document.querySelector<SVGElement>("[data-battery]");
  const batteryLevel = document.querySelector<SVGRectElement>("[data-battery-level]");
  const getBattery = (navigator as Navigator & { getBattery?: () => Promise<BatteryManager> }).getBattery;

  if (battery && batteryLevel && getBattery) {
    const FULL_WIDTH = 20;
    getBattery
      .call(navigator)
      .then((manager) => {
        const show = () => {
          const percent = Math.round(manager.level * 100);
          batteryLevel.setAttribute("width", String(Math.max(1.5, FULL_WIDTH * manager.level)));
          battery.dataset.state = manager.charging ? "charging" : percent <= 20 ? "low" : "";
          battery.setAttribute("aria-label", `Battery ${percent}%${manager.charging ? ", charging" : ""}`);
        };
        show();
        manager.addEventListener("levelchange", show);
        manager.addEventListener("chargingchange", show);
      })
      .catch(() => {});
  }

  // Control Center toggles light / dark
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", toggleTheme);
</script>
