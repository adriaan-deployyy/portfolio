---
import "../styles/tokens.css";

interface Props {
  title?: string;
  /** Shown under the title in search results and link previews */
  description?: string;
  /** Link-preview image, 1200 x 630, in public/ */
  image?: string;
}

const {
  title = "Adriaan Myburgh",
  description = "Product and web designer for B2B SaaS and founder of Deployyy.co. Explore client projects, my CV and more on a macOS-style desktop.",
  image = "/og-image.jpg",
} = Astro.props;

// Share tags need absolute URLs (astro.config.mjs sets the site's address)
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Favicon: Figma Designs → Favicon. SVG for modern browsers, .ico as the fallback -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!-- Link previews (LinkedIn, WhatsApp, Slack, iMessage, X…): Open Graph + Twitter card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Adriaan Myburgh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Adriaan Myburgh's macOS-style portfolio desktop" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <!--
      Set the theme before first paint so the wallpaper never flashes the wrong mode.
      Visitor's local time decides: light 06:00–18:59, dark 19:00–05:59 (same rule as scripts/theme.ts).
      A manual switch (Dock / Control Center) wins for the rest of that visit only.
    -->
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = sessionStorage.getItem("theme");
          localStorage.removeItem("theme"); // older builds remembered the choice forever
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          const hour = new Date().getHours();
          theme = hour >= 6 && hour < 19 ? "light" : "dark";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <!-- Windows visitors get Switzer as the UI font; preload it so the menu bar doesn't reflow -->
    <script is:inline>
      (() => {
        const platform = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;
        if (!/win/i.test(platform)) return;
        document.documentElement.dataset.os = "windows";
        const preload = document.createElement("link");
        Object.assign(preload, { rel: "preload", as: "font", type: "font/woff2", crossOrigin: "anonymous" });
        preload.href = "/fonts/Switzer-Variable.woff2";
        document.head.append(preload);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
